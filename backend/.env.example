# ---------------------------------------------------------------- development
# One process, SQLite, local evidence storage. Never use these values anywhere
# a real report could be filed.
ENV=development
PROFILE=all
CASE_DB_URL=sqlite:///./data/case.db
INTAKE_DB_URL=sqlite:///./data/intake.db
INTAKE_HMAC_KEY=dev-hmac-key-change-me
# python -c "from app.security import generate_fernet_key; print(generate_fernet_key())"
INTAKE_ENC_KEY=
JWT_SECRET=dev-only-change-me
STORAGE_BACKEND=local
EVIDENCE_DIR=./data/evidence

# ---------------------------------------------------------------- production
# ENV=production makes config.py refuse to start on any of the following:
#   * a development JWT secret, or one under 32 characters
#   * SQLite
#   * PROFILE=all
#   * a dept service holding intake credentials
#   * a public or dept service holding the decryption key
#   * local disk evidence storage
#   * CORS_ORIGINS=* or TRUSTED_HOSTS=*
#   * PUBLISH_NAMES_BEFORE_FINDING=true
#   * metrics exposed without a scrape token
#
# Generate secrets:
#   JWT_SECRET        python -c "import secrets; print(secrets.token_urlsafe(48))"
#   INTAKE_HMAC_KEY   python -c "import secrets; print(secrets.token_urlsafe(48))"
#   INTAKE_ENC_KEY    python -c "from app.security import generate_fernet_key; print(generate_fernet_key())"
#
# Rotating INTAKE_HMAC_KEY orphans every existing contact row - the token can
# no longer be recomputed. Treat both keys as unrotatable without a migration
# plan, and hold them in a KMS or sealed secret, never in this file.
#
# public.env
#   ENV=production
#   PROFILE=public
#   CASE_DB_URL=postgresql+psycopg://civiclens_rw:...@case-db/cases
#   INTAKE_DB_URL=postgresql+psycopg://intake_writer:...@intake-db/intake   # INSERT only
#   INTAKE_HMAC_KEY=...
#   INTAKE_ENC_KEY=...            # seals; the write-only DB role prevents reading back
#   STORAGE_BACKEND=s3
#   S3_BUCKET=civiclens-evidence
#   CORS_ORIGINS=https://civiclens.gov.example
#   TRUSTED_HOSTS=api.civiclens.gov.example
#   METRICS_TOKEN=...
#
# dept.env
#   ENV=production
#   PROFILE=dept
#   CASE_DB_URL=postgresql+psycopg://civiclens_ro:...@case-db/cases
#   (no INTAKE_DB_URL, no INTAKE_HMAC_KEY, no INTAKE_ENC_KEY - the service
#    refuses to boot if any of them appear)
#   STORAGE_BACKEND=s3
#   S3_BUCKET=civiclens-evidence
#   CORS_ORIGINS=https://civiclens.gov.example
#   TRUSTED_HOSTS=api.civiclens.gov.example
#   METRICS_TOKEN=...
#
# investigator.env
#   ENV=production
#   PROFILE=investigator
#   CASE_DB_URL=postgresql+psycopg://civiclens_rw:...@case-db/cases
#   INTAKE_DB_URL=postgresql+psycopg://intake_reader:...@intake-db/intake
#   INTAKE_HMAC_KEY=...
#   INTAKE_ENC_KEY=...
#   STORAGE_BACKEND=s3
#   S3_BUCKET=civiclens-evidence
#   CORS_ORIGINS=https://ombudsman.gov.example
#   TRUSTED_HOSTS=investigator.civiclens.gov.example
#   METRICS_TOKEN=...
