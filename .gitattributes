# Line endings.
#
# The container entrypoint and run.sh execute inside Linux. If git checks them
# out with CRLF - the Windows default - the kernel reads the shebang as
# "/usr/bin/env sh\r" and the deploy fails with "no such file or directory",
# which is a genuinely baffling error to debug on a platform build.
* text=auto eol=lf

*.sh        text eol=lf
Dockerfile  text eol=lf
*.conf      text eol=lf

# These only ever run on Windows.
*.ps1       text eol=crlf
*.bat       text eol=crlf

# Never mangled.
*.png binary
*.jpg binary
*.pdf binary
*.ico binary
