# ---------------------------------------------------------------------------
# CivicLens on Railway - variables to paste into each service.
#
# Values written as ${{...}} are Railway variable references: type them exactly
# as shown and Railway resolves them, so no password is ever copied by hand.
# ---------------------------------------------------------------------------

# === Shared by every service ===============================================
# Generate ONCE, then use the same values everywhere they appear.
#   JWT_SECRET       python -c "import secrets; print(secrets.token_urlsafe(48))"
#   INTAKE_HMAC_KEY  python -c "import secrets; print(secrets.token_urlsafe(48))"
#   INTAKE_SEAL_KEY   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# INTAKE_HMAC_KEY cannot be rotated later without orphaning every sealed
# contact. Save all three in a password manager now.


# ===========================================================================
# OPTION 1 - ONE SERVICE  (demonstration; simplest)
# ===========================================================================
# Service "civiclens", one Postgres. ENV=staging because a single process
# serving all three surfaces is not the separated architecture, and
# ENV=production refuses to start that way rather than pretending.
#
# ENV=staging
# PROFILE=all
# DATABASE_URL=${{Postgres.DATABASE_URL}}
# INTAKE_DATABASE_URL=${{Postgres.DATABASE_URL}}
# JWT_SECRET=<paste>
# INTAKE_HMAC_KEY=<paste>
# INTAKE_SEAL_KEY=<seal key>
# SERVE_FRONTEND=true
# DEMO_MODE=true
# SEED_ON_START=true
# STORAGE_BACKEND=local
# TRUSTED_HOSTS=*.up.railway.app,<your-domain-if-any>
# CORS_ORIGINS=none
# METRICS_ENABLED=false


# ===========================================================================
# OPTION 2 - THREE SERVICES  (the real architecture)
# ===========================================================================
# Two Postgres databases ("Postgres" and "IntakePostgres") and three services
# built from this same repo. Read the three blocks side by side: what protects
# reporters is the variables the dept service does NOT have.

# --- service: civiclens-public  (citizens; this is the public URL) ---------
# ENV=production
# PROFILE=public
# PORT=8000
# DATABASE_URL=${{Postgres.DATABASE_URL}}
# INTAKE_DATABASE_URL=${{IntakePostgres.DATABASE_URL}}
# JWT_SECRET=<paste>
# INTAKE_HMAC_KEY=<paste>
# INTAKE_SEAL_KEY=<seal key - the public half>
# SERVE_FRONTEND=true
# DEMO_MODE=false
# STORAGE_BACKEND=s3
# S3_BUCKET=<bucket>
# S3_ENDPOINT_URL=<endpoint>        # Cloudflare R2, Backblaze B2, AWS S3
# AWS_ACCESS_KEY_ID=<key>
# AWS_SECRET_ACCESS_KEY=<secret>
# TRUSTED_HOSTS=civiclens.<your-domain>
# CORS_ORIGINS=none
# METRICS_TOKEN=<paste>
#
# Note: on Railway both services share one Postgres role, so the public
# service can technically read the intake table as well as write it. On a
# single-tenant host you would give it an INSERT-only role. Until then, the
# separation rests on the dept service below - which is the account an accused
# official actually has.

# --- service: civiclens-dept  (departmental officers) ----------------------
# ENV=production
# PROFILE=dept
# PORT=8000
# DATABASE_URL=${{Postgres.DATABASE_URL}}
# JWT_SECRET=<paste>
# SERVE_FRONTEND=true
# STORAGE_BACKEND=s3
# S3_BUCKET=<bucket>
# S3_ENDPOINT_URL=<endpoint>
# AWS_ACCESS_KEY_ID=<key>
# AWS_SECRET_ACCESS_KEY=<secret>
# TRUSTED_HOSTS=dept.<your-domain>
# CORS_ORIGINS=none
# METRICS_TOKEN=<paste>
#
# NO INTAKE_DATABASE_URL. NO INTAKE_HMAC_KEY. NO INTAKE_SEAL_KEY. NO INTAKE_OPEN_KEY.
# That absence is the privacy firewall. The service refuses to boot if any of
# them appear, so a paste into the wrong dashboard fails loudly.

# --- service: civiclens-investigator  (Ombudsman) --------------------------
# ENV=production
# PROFILE=investigator
# PORT=8000
# DATABASE_URL=${{Postgres.DATABASE_URL}}
# INTAKE_DATABASE_URL=${{IntakePostgres.DATABASE_URL}}
# JWT_SECRET=<paste>
# INTAKE_HMAC_KEY=<paste>
# INTAKE_SEAL_KEY=<seal key>
# SERVE_FRONTEND=false
# STORAGE_BACKEND=s3
# S3_BUCKET=<bucket>
# S3_ENDPOINT_URL=<endpoint>
# AWS_ACCESS_KEY_ID=<key>
# AWS_SECRET_ACCESS_KEY=<secret>
# TRUSTED_HOSTS=ombudsman.<your-domain>
# CORS_ORIGINS=none
# METRICS_TOKEN=<paste>

# --- service: civiclens-jobs  (scheduled sweeps; start command: jobs) ------
# Same variables as civiclens-investigator, plus:
# JOB_INTERVAL_SECONDS=3600
